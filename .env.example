# このファイルをコピーして .env を作成し、値を記入してください。
#   copy .env.example .env
# .env は git 管理外です。値を書いたファイルをコミット・共有しないでください。

# --- 閉鎖済み旧ポータル（過去仕様の参考値。現行処理では未使用） ---
DBS_ACCOUNT=
DBS_PASSWORD=
DBS_TOP_PAGE=

# --- 閉鎖済み旧ポータル・作業員用（過去仕様の参考値。現行処理では未使用） ---
DBS_WORKER_ACCOUNT=
DBS_WORKER_PASSWORD=
DBS_WORKER_TOP_PAGE=

# --- 刷新後 (2026年8月〜) の新管理ポータル ---
# 事業者用・作業員用の区別は廃止され、単一ポータルに統合されました。
# 認証基盤は AWS Cognito の Hosted UI で、ログインIDは「メールアドレス」形式です。
# 現行処理では以下3項目が必須です。旧ポータル設定へのフォールバックは行いません。
DBS_LOGIN_URL=
DBS_LOGIN_EMAIL=
DBS_LOGIN_PASSWORD=

# --- 車両位置詳細の追加取得 ---
# ポート外車両など対象車両の /api/attachments/{attachmentId} を取得します。
# 負荷が気になる場合は false にすると、車両一覧取得だけを継続します。
DBS_VEHICLE_LOCATION_FETCH_ENABLED=true
# 1回の実行で詳細取得する最大台数（超過分は「上限超過」として記録）
#DBS_VEHICLE_LOCATION_FETCH_MAX_PER_RUN=500
# 1時間周期でポート所属車両を含む全車両を取得する間隔（秒）
#DBS_VEHICLE_LOCATION_FETCH_INTERVAL_SEC=3600
# 全車両位置取得完了後の次回車両スクレイピング抑止時間（秒）
#DBS_VEHICLE_LOCATION_POST_FULL_COOLDOWN_SEC=600
# 実測GPSとポート座標の不整合判定距離（メートル）
#DBS_VEHICLE_LOCATION_MISMATCH_THRESHOLD_M=100
# 詳細API呼び出し間隔（ミリ秒）
#DBS_VEHICLE_LOCATION_FETCH_DELAY_MS=100

# --- 出力先・ブラウザ設定 ---
# CSV等の出力先フォルダ。相対パスならプロジェクトルート基準。
OUTPUT_DIR=output
# ヘッドレス実行するか (true / false)
HEADLESS=False

# --- OneDrive (CSVバックアップのアップロード先) ---
ONEDRIVE_SHARED_LINK=
ONEDRIVE_PASSWORD=

# --- メール2段階認証コードの受け渡し (Power Automate -> OneDrive 共有ファイル) ---
# 仕様: docs/email-2fa-power-automate-spec.md
# dbs_auth_code.txt 単体に発行した「パスワード付き共有リンク」のURLをそのまま貼り付けます。
DBS_MAILCODE_SHARE_LINK=
# 上記共有リンクに設定したパスワード。
DBS_MAILCODE_SHARE_PASSWORD=
# 以下は任意。未設定ならコメントの既定値が使われます。
#DBS_MAILCODE_TIMEOUT_SEC=180
#DBS_MAILCODE_POLL_SEC=10
#DBS_MAILCODE_MAX_AGE_SEC=600
#DBS_MAILCODE_CLOCK_SKEW_SEC=60
# コード抽出パターンの明示指定。空ならキーワード近傍の4〜8桁を自動抽出。
#DBS_MAILCODE_REGEX=

# --- Cloudflare R2 (ダッシュボードデータの公開先) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- 通知 ---
SLACK_WEBHOOK_URL=

# --- 動作モード (通常は未設定) ---
# MAP_DATA_ONLY を指定するとスクレイピングを行わず、既存CSVからマップデータのみ再生成します。
#DBS_RUN_MODE=
# 緊急停止スイッチ。true にするとスクレイピングをスキップします。
#DBS_DISABLE_SCRAPING=
#DBS_MAINTENANCE_MODE=
